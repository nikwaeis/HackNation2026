# Base URL of the WodoPlon API as seen by the browser (endpoints: <base>/crops, <base>/analyze, <base>/reports/{uuid}).
# Default "/api" = same origin (Vite dev proxy or nginx in production). Example for a direct call: http://localhost:5254/api
VITE_API_BASE_URL=/api

# Dev server only: where Vite forwards /api (ASP.NET Core API). In docker-compose: http://api:8080
VITE_API_PROXY_TARGET=http://localhost:5254

# "true" = always use the built-in demo report (no backend needed)
VITE_USE_MOCK=false
