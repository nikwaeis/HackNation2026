+    ports:
+      - "${FRONTEND_PORT:-5173}:5173"
+    volumes:
+      - ./src/frontend:/app
+      # keep the container's node_modules (Linux binaries) separate from the host
+      - /app/node_modules
+    depends_on:
+      - api
 
