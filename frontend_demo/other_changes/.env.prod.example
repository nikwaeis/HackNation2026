# prod: copy to .env.prod — no passwords/keys here, they go to ./secrets/*
API_PORT=8080
POSTGRES_DB=WodoPlon
POSTGRES_USER=wodoplon

Cors__WebOrigin=https://wodoplon.example.com

# Python microservice (when enabled in docker-compose)
# PythonService__BaseUrl=http://python-service:8000

# ./secrets/ files (one value each, no trailing newline):
#   db_password       <password>
#   db_connection     Host=postgres;Database=WodoPlon;Username=wodoplon;Password=<password>
#   redis_password    <password>
#   redis_connection  redis:6379,password=<password>

# Frontend (nginx): "/api" = same origin, proxied by nginx to the api service
# FRONTEND_PORT=80
# VITE_API_BASE_URL=/api
